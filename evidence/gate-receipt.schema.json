{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brandyn-s/minerva/evidence/gate-receipt.schema.json",
  "title": "Minerva content-free gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gate",
    "status",
    "sourceRevision",
    "dependencyReceipts",
    "authorityReferences",
    "environmentIds",
    "configurationIds",
    "configuration",
    "toolVersions",
    "commands",
    "observableOutcome",
    "demoResult",
    "smallestDecisiveEvidence",
    "evidenceLevel",
    "firstMaterialFalsifier",
    "falsifierOccurred",
    "failures",
    "partialResults",
    "unsupportedCases",
    "materialRepairs",
    "decisions",
    "productOwnerApproval"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": { "$ref": "#/$defs/gateId" },
    "status": {
      "enum": [
        "not started",
        "active",
        "passed",
        "falsified",
        "superseded"
      ]
    },
    "sourceRevision": { "$ref": "#/$defs/gitRevision" },
    "dependencyReceipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "receiptPath", "sourceRevision"],
        "properties": {
          "gate": { "$ref": "#/$defs/gateId" },
          "receiptPath": { "$ref": "#/$defs/nonEmptyString" },
          "sourceRevision": { "$ref": "#/$defs/gitRevision" }
        }
      }
    },
    "authorityReferences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "environmentIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "githubRepository",
        "githubVisibility",
        "canonicalBranch",
        "vercelScope",
        "vercelTeamId",
        "vercelProject",
        "vercelProjectId",
        "deploymentCount",
        "integrationCount",
        "productionAlias"
      ],
      "properties": {
        "githubRepository": { "$ref": "#/$defs/nonEmptyString" },
        "githubVisibility": { "enum": ["private", "public"] },
        "canonicalBranch": { "$ref": "#/$defs/nonEmptyString" },
        "vercelScope": { "$ref": "#/$defs/nonEmptyString" },
        "vercelTeamId": { "$ref": "#/$defs/nonEmptyString" },
        "vercelProject": { "$ref": "#/$defs/nonEmptyString" },
        "vercelProjectId": { "$ref": "#/$defs/nonEmptyString" },
        "deploymentCount": { "type": "integer", "minimum": 0 },
        "integrationCount": { "type": "integer", "minimum": 0 },
        "productionAlias": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "configurationIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "key", "target"],
        "properties": {
          "id": { "$ref": "#/$defs/nonEmptyString" },
          "key": { "pattern": "^[A-Z][A-Z0-9_]+$", "type": "string" },
          "target": { "enum": ["development", "preview", "production"] }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browserDatabaseNamespace",
        "admissionNamespaces",
        "providerRoutesEnabled",
        "vercelFramework",
        "vercelNodeVersion"
      ],
      "properties": {
        "browserDatabaseNamespace": { "$ref": "#/$defs/nonEmptyString" },
        "admissionNamespaces": {
          "type": "object",
          "additionalProperties": false,
          "required": ["development", "preview", "production"],
          "properties": {
            "development": { "$ref": "#/$defs/nonEmptyString" },
            "preview": { "$ref": "#/$defs/nonEmptyString" },
            "production": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "providerRoutesEnabled": {
          "type": "object",
          "additionalProperties": false,
          "required": ["development", "preview", "production"],
          "properties": {
            "development": { "type": "boolean" },
            "preview": { "type": "boolean" },
            "production": { "type": "boolean" }
          }
        },
        "vercelFramework": { "$ref": "#/$defs/nonEmptyString" },
        "vercelNodeVersion": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "toolVersions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "summary"],
        "properties": {
          "command": { "$ref": "#/$defs/nonEmptyString" },
          "result": { "enum": ["pass", "fail", "not-run"] },
          "summary": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "observableOutcome": { "$ref": "#/$defs/nonEmptyString" },
    "demoResult": { "$ref": "#/$defs/nonEmptyString" },
    "smallestDecisiveEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "evidenceLevel": { "$ref": "#/$defs/nonEmptyString" },
    "firstMaterialFalsifier": { "$ref": "#/$defs/nonEmptyString" },
    "falsifierOccurred": { "type": "boolean" },
    "failures": { "$ref": "#/$defs/stringList" },
    "partialResults": { "$ref": "#/$defs/stringList" },
    "unsupportedCases": { "$ref": "#/$defs/stringList" },
    "materialRepairs": { "$ref": "#/$defs/stringList" },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opened", "closed", "result"],
      "properties": {
        "opened": { "$ref": "#/$defs/stringList" },
        "closed": { "$ref": "#/$defs/stringList" },
        "result": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "productOwnerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "recorded", "reference"],
      "properties": {
        "required": { "type": "boolean" },
        "recorded": { "type": "boolean" },
        "reference": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "gate": { "const": "R0" } } },
      "then": {
        "properties": {
          "configurationIds": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6
          }
        }
      }
    }
  ],
  "$defs": {
    "gateId": { "type": "string", "pattern": "^R[0-9]+[A-Z]?$" },
    "gitRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  }
}
