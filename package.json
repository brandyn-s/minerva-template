{
  "name": "minerva",
  "version": "0.0.0",
  "private": true,
  "description": "A spatial thinking environment for directing AI with explicit context and durable lineage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandyn-s/minerva-template.git"
  },
  "bugs": {
    "url": "https://github.com/brandyn-s/minerva-template/issues"
  },
  "homepage": "https://github.com/brandyn-s/minerva-template#readme",
  "engines": {
    "node": "24.20.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "launch": "node scripts/launch.mjs",
    "deploy:ops": "node scripts/deploy.mjs",
    "test:ops": "node --test tests/launch.test.mjs tests/deploy.test.mjs tests/workflow.test.mjs",
    "security:audit": "npm audit --audit-level=low",
    "secrets:scan": "sh scripts/scan-secrets.sh",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
